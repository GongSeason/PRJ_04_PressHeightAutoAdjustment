<Window x:Class="CrimpHeightAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:CrimpHeightAnalyzer.ViewModels"
        xmlns:conv="clr-namespace:CrimpHeightAnalyzer.Converters"
        mc:Ignorable="d"
        Title="压接高度反馈控制系统"
        WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        FontFamily="Segoe UI, SimHei"
        Background="Transparent">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IndustrialButton" TargetType="Button">
            <Setter Property="Background" Value="#FF252525"/>
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="BorderBrush" Value="#FF333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2E2E2E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF00BFA5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB0B0B0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF161616"/>
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="BorderBrush" Value="#FF333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFFAFAFA"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- 主窗体圆角容器 -->
    <Border CornerRadius="8" Background="#FF121212" BorderBrush="#FF2A2A2A" BorderThickness="1"
            Padding="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Border Grid.Row="0" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Image Grid.Column="0" Source="/Resources/Logo.png" Width="220"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Margin="0,0,16,0" Stretch="Uniform"/>

                <!-- 居中标题 -->
                <TextBlock Grid.Column="1" Text="压接高度反馈系统" FontSize="18" FontWeight="Bold"
                           Foreground="#FFFAFAFA" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="刷新" Command="{Binding RefreshDataCommand}"
                            Style="{StaticResource IndustrialButton}" Margin="0,0,8,0" Padding="12,5" FontSize="12"/>
                    <Button Content="设置" Command="{Binding ToggleSettingsCommand}"
                            Style="{StaticResource IndustrialButton}" Padding="12,5" FontSize="12"/>
                </StackPanel>

                <!-- 窗口控制按钮（标准 Button，Click 事件） -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="-" Click="MinimizeBtn_Click" Background="Transparent" Foreground="#FFB0B0B0"
                            BorderThickness="0" Width="46" Height="48" FontSize="20" FontWeight="Bold" Cursor="Hand"
                            ToolTip="最小化"/>
                    <Button Content="☐" Click="MaximizeBtn_Click" Background="Transparent" Foreground="#FFB0B0B0"
                            BorderThickness="0" Width="46" Height="48" FontSize="14" Cursor="Hand"
                            ToolTip="最大化"/>
                    <Button Content="X" Click="CloseBtn_Click" Background="Transparent" Foreground="#FFB0B0B0"
                            BorderThickness="0" Width="46" Height="48" FontSize="14" FontWeight="Bold" Cursor="Hand"
                            ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主内容区 ===== -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 上半部分：三列布局 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 压头A -->
                    <Border Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 标题 + 状态 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock FontSize="14" FontWeight="Bold"
                                           Foreground="#FF42A5F5" VerticalAlignment="Center">
                                    <Run Text="铆压#1"/>
                                    <Run Text="（1高度）" FontSize="11" FontWeight="Normal" Foreground="#FF757575"/>
                                </TextBlock>
                                <Border Background="{Binding HeadAStateColor}" CornerRadius="3" Padding="8,3" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding HeadAState}" FontSize="11" FontWeight="Bold"
                                               Foreground="#FF000000"/>
                                </Border>
                            </StackPanel>

                            <!-- 核心指标：调整量（大字突出） -->
                            <Border Grid.Row="1" Background="#FF1A1A1A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="PLC 调整量" FontSize="11" Foreground="#FF757575" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding HeadAAdjustment}" FontSize="22" FontWeight="Bold"
                                               Foreground="{Binding HeadAAdjustmentColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 辅助指标 -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="偏差" FontSize="10" Foreground="#FF757575"/>
                                    <TextBlock Text="{Binding HeadADeviation}" 
                                               FontSize="13" FontWeight="SemiBold" Foreground="#FFFAFAFA"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Slope" FontSize="10" Foreground="#FF757575"/>
                                    <TextBlock Text="{Binding HeadASlope}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#FF90CAF9"/>
                                </StackPanel>
                            </Grid>

                            <!-- 单产品统计 -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="1高度截尾均值" FontSize="10" Foreground="#FF757575"/>
                                    <TextBlock Text="{Binding HeadAProduct1Mean}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#FF42A5F5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="标准差" FontSize="10" Foreground="#FF757575"/>
                                    <TextBlock Text="{Binding HeadAProduct1StdDev}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#FFFAFAFA"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 压头B -->
                    <Border Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource CardBorder}" Margin="6,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 标题 + 状态 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock FontSize="14" FontWeight="Bold"
                                           Foreground="#FFFFB74D" VerticalAlignment="Center">
                                    <Run Text="铆压#2"/>
                                    <Run Text="（2高度）" FontSize="11" FontWeight="Normal" Foreground="#FF757575"/>
                                </TextBlock>
                                <Border Background="{Binding HeadBStateColor}" CornerRadius="3" Padding="8,3" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding HeadBState}" FontSize="11" FontWeight="Bold"
                                               Foreground="#FF000000"/>
                                </Border>
                            </StackPanel>

                            <!-- 核心指标：调整量（大字突出） -->
                            <Border Grid.Row="1" Background="#FF1A1A1A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="PLC 调整量" FontSize="11" Foreground="#FF757575" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding HeadBAdjustment}" FontSize="22" FontWeight="Bold"
                                               Foreground="{Binding HeadBAdjustmentColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 辅助指标 -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="偏差" FontSize="10" Foreground="#FF757575"/>
                                    <TextBlock Text="{Binding HeadBDeviation}" 
                                               FontSize="13" FontWeight="SemiBold" Foreground="#FFFAFAFA"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Slope" FontSize="10" Foreground="#FF757575"/>
                                    <TextBlock Text="{Binding HeadBSlope}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#FF90CAF9"/>
                                </StackPanel>
                            </Grid>

                            <!-- 单产品统计 -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="2高度截尾均值" FontSize="10" Foreground="#FF757575"/>
                                    <TextBlock Text="{Binding HeadBProduct1Mean}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#FFFFB74D"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="标准差" FontSize="10" Foreground="#FF757575"/>
                                    <TextBlock Text="{Binding HeadBProduct1StdDev}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#FFFAFAFA"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 右侧：参数 + 告警 -->
                    <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource CardBorder}" Margin="6,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="调整参数" FontSize="12" FontWeight="Bold" Foreground="#FFB0B0B0" Margin="0,0,0,8"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Grid.Row="0">
                                    <TextBlock Text="下限" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Settings.Controller.LowerLimit, StringFormat=F3}" Foreground="#FFFAFAFA" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="0">
                                    <TextBlock Text="目标" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Settings.TargetMidpoint, StringFormat=F3}" Foreground="#FF00BFA5" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="0">
                                    <TextBlock Text="上限" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Settings.Controller.UpperLimit, StringFormat=F3}" Foreground="#FFFAFAFA" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Grid.Row="0">
                                    <TextBlock Text="容差" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Foreground="#FFFAFAFA" FontSize="14" FontWeight="SemiBold">
                                        <Run Text="±"/>
                                        <Run Text="{Binding Settings.Controller.UpperTolerance, StringFormat=F3}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="增益 K" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Settings.Controller.ControllerGain, StringFormat=F1}" Foreground="#FFFAFAFA" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="发散 T" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Settings.Controller.DivergenceThreshold, StringFormat=F3}" Foreground="#FFFAFAFA" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="窗口" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Settings.Controller.WindowSize}" Foreground="#FFFAFAFA" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="Drift N" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Settings.Controller.DriftConfirmCycles}" Foreground="#FFFAFAFA" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 告警 -->
                    <Border Grid.Column="2" Grid.Row="1" Margin="6,6,0,0" Padding="10,8"
                            Background="#FF2D1515" BorderBrush="#FFB71C1C" BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding HasAlert, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="⚠ 告警" FontSize="12" FontWeight="Bold" Foreground="#FFFF5252" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding AlertText}" Foreground="#FFFFAB91" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 趋势图 -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding TrendChartTitle}" FontSize="12"
                                   FontWeight="Bold" Foreground="#FFB0B0B0" Margin="0,0,0,8"/>

                        <lvc:CartesianChart Grid.Row="1" Grid.Column="0"
                                            Series="{Binding TrendSeries}"
                                            XAxes="{Binding TrendXAxes}"
                                            YAxes="{Binding TrendYAxes}"
                                            Sections="{Binding TrendSections}"
                                            LegendPosition="Hidden"
                                            TooltipPosition="Center"/>

                        <!-- 自定义图例 + 产品可见性控制 -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="16" Height="3" Background="#FFFF006E" VerticalAlignment="Center" CornerRadius="1"/>
                                <CheckBox Content="1高度" IsChecked="{Binding IsP1Visible}" Foreground="#FFFF006E"
                                          Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="16" Height="3" Background="#FF8338EC" VerticalAlignment="Center" CornerRadius="1"/>
                                <CheckBox Content="2高度" IsChecked="{Binding IsP2Visible}" Foreground="#FF8338EC"
                                          Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 设置面板 -->
            <Border Grid.Column="1" Width="300" Background="#FF1A1A1A" BorderBrush="#FF2A2A2A"
                    BorderThickness="1,0,0,0" Visibility="{Binding IsSettingsPanelOpen, Converter={StaticResource BoolToVis}}"
                    Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="设置" FontSize="16" FontWeight="Bold" Foreground="#FFFAFAFA" Margin="0,0,0,16"/>

                        <TextBlock Text="监视路径" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Settings.MonitorPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="..." Command="{Binding BrowseFolderCommand}"
                                    Style="{StaticResource IndustrialButton}" Padding="10,5" VerticalAlignment="Top" FontSize="12"/>
                        </Grid>

                        <TextBlock Text="扫描天数（0=全部）" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.ScanDays, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,12"/>

                        <Border Height="1" Background="#FF2A2A2A" Margin="0,4,0,12"/>

                        <TextBlock Text="上限 (mm)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.UpperLimit, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="下限 (mm)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.LowerLimit, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="截尾比例" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.TrimPercentage, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="容差上限 (mm)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.UpperTolerance, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="容差下限 (mm)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.LowerTolerance, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="刷新间隔 (秒)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <Border Height="1" Background="#FF2A2A2A" Margin="0,4,0,12"/>

                        <TextBlock Text="控制参数" FontSize="13" FontWeight="Bold" Foreground="#FFB0B0B0" Margin="0,0,0,10"/>

                        <TextBlock Text="增益 K" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.ControllerGain, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="发散阈值 T (mm)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.DivergenceThreshold, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="降K系数" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.DegradedGainFactor, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="最小样本数" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.MinSamplesPerEpoch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="Drift 拍数 N" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.DriftConfirmCycles, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="Drift Slope 门限 (mm/拍)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.DriftSlopeThreshold, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="窗口大小" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.WindowSize, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="单步限幅 (mm)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.MaxStepPerAdjust, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="安全上限 (mm)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.SafetyUpperBound, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="安全下限 (mm)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Controller.SafetyLowerBound, UpdateSourceTrigger=LostFocus, StringFormat=F4, ValidatesOnExceptions=True, NotifyOnValidationError=True}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                        <Border Height="1" Background="#FF2A2A2A" Margin="0,4,0,12"/>

                        <TextBlock Text="PLC 通信" FontSize="13" FontWeight="Bold" Foreground="#FFB0B0B0" Margin="0,0,0,10"/>

                        <!-- PLC 启用开关 -->
                        <CheckBox Content="启用 PLC 通信" IsChecked="{Binding Settings.Plc.UseRealPlc}"
                                  Foreground="#FFFAFAFA" FontSize="13" Margin="0,0,0,12"/>

                        <!-- PLC 连接状态 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse Width="10" Height="10" Fill="{Binding PlcStatusColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PlcStatusText}" Foreground="#FFB0B0B0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>

                        <TextBlock Text="PLC IP 地址" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Plc.IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="PLC 端口" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Plc.Port, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="连接超时 (ms)" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Plc.ConnectTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="压头A调整地址" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Plc.HeadAAdjustAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="压头B调整地址" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Plc.HeadBAdjustAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="停机信号地址" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Plc.StopSignalAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="压头A位置地址" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Plc.HeadAPositionAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="压头B位置地址" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.Plc.HeadBPositionAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                        <Button Content="保存设置" Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource IndustrialButton}" Width="268"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 加载遮罩 -->
        <Border Grid.Row="1" Background="#CC000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="正在加载..." Foreground="#FFFAFAFA" FontSize="18" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
